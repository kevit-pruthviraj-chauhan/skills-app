    "apps/server/.env.example": "# Environment Configuration\n# Copy this file to .env and update the values\n\n# Application\nDEBUG=true\nHOST=0.0.0.0\nPORT=8000\n\n# Allowed web origin for CORS (unset or empty = allow any origin)\nCORS_ORIGIN=http://localhost:5173\n\n# Database (if using SQLAlchemy/SQLModel)\nMONGODB_URI=mongodb://localhost:27017\nMONGODB_DATABASE=skills-app\n\n# OpenAI (if using AI frameworks)\nOPENAI_API_KEY=your-openai-api-key\n\n# Anthropic (if using Anthropic SDK)\nANTHROPIC_API_KEY=your-anthropic-api-key\n\n# Celery (if using task queue)\nCELERY_BROKER_URL=redis://localhost:6379/0\nCELERY_RESULT_BACKEND=redis://localhost:6379/0\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"check-types\": \"tsc --noEmit\",\n    \"dev\": \"vite dev\",\n    \"build\": \"vite build\",\n    \"serve\": \"vite preview\",\n    \"start\": \"vite\",\n    \"test\": \"vitest run --passWithNoTests\"\n  },\n  \"dependencies\": {\n    \"@base-ui/react\": \"^1.8.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"next-themes\": \"^0.4.6\",\n    \"react\": \"19.2.8\",\n    \"react-dom\": \"19.2.8\",\n    \"react-router\": \"^8.4.0\",\n    \"sonner\": \"^2.0.8\",\n    \"tailwind-merge\": \"^3.7.0\",\n    \"zod\": \"catalog:\",\n    \"dotenv\": \"catalog:\",\n    \"@skills-app/env\": \"workspace:*\",\n    \"axios\": \"^1.20.0\",\n    \"lucide-react\": \"^1.21.0\",\n    \"shadcn\": \"^4.21.1\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"radix-ui\": \"^1.6.7\",\n    \"@fontsource-variable/inter\": \"^5.3.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.4\",\n    \"@types/react\": \"~19.2.18\",\n    \"@types/react-dom\": \"~19.2.7\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"typescript\": \"^5\",\n    \"vite\": \"^8.3.2\",\n    \"@skills-app/config\": \"workspace:*\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/user-event\": \"^14.6.7\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"skills-app\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.6.5\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"nx run web --target=dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"nx run-many -t build\",\n    \"check-types\": \"nx run-many -t check-types\",\n    \"dev:web\": \"nx run web --target=dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"setup:server\": \"bash scripts/native/task-2.sh\",\n    \"check:server\": \"bash scripts/native/task-3.sh\",\n    \"test:server\": \"bash scripts/native/task-4.sh\",\n    \"setup:part:backend:python:fastapi\": \"bash scripts/native/task-2.sh\",\n    \"dev:part:backend:python:fastapi\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:python:fastapi\": \"bash scripts/native/task-3.sh\",\n    \"test:part:backend:python:fastapi\": \"bash scripts/native/task-4.sh\",\n    \"lint:eslint\": \"eslint .\",\n    \"format:prettier\": \"prettier --write .\",\n    \"format:prettier:check\": \"prettier --check .\",\n    \"secrets:scan\": \"gitleaks git --redact --verbose\",\n    \"secrets:scan:staged\": \"gitleaks git --pre-commit --redact --staged --verbose\",\n    \"test\": \"bun run --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"^6.0.3\",\n    \"@skills-app/config\": \"workspace:*\",\n    \"vercel\": \"^54.18.2\",\n    \"nx\": \"^23.2.1\",\n    \"eslint\": \"^10.12.0\",\n    \"@eslint/js\": \"^10.0.1\",\n    \"typescript-eslint\": \"^8.71.0\",\n    \"globals\": \"^17.13.0\",\n    \"prettier\": \"^3.9.9\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@skills-app/env\": \"workspace:*\"\n  }\n}\n",
    "packages/config/package.json": "{\n  \"name\": \"@skills-app/config\",\n  \"version\": \"0.0.0\",\n  \"private\": true\n}\n",
    "packages/env/package.json": "{\n  \"name\": \"@skills-app/env\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"exports\": {\n    \"./web\": \"./src/web.ts\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@t3-oss/env-core\": \"^0.13.11\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@skills-app/config\": \"workspace:*\"\n  }\n}\n"
  }
